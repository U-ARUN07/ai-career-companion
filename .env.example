# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Store and Storage Paths
DATA_DIR=data
VECTOR_STORE_DIR=vector_store
INTERNSHIPS_FILE=data/internships.json
TEST_CANDIDATES_FILE=data/test_candidates.json
FAISS_INDEX_FILE=vector_store/faiss_index.bin
METADATA_FILE=vector_store/internships_metadata.json

# Optional LLM Explanation API Keys (Free/Rule-Based fallback active when left blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
EXPLANATION_PROVIDER=rule_based
