{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Unified Internship System",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\run.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pytest Test Suite",
      "type": "shell",
      "command": "python -m pytest",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
